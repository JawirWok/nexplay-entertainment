{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{database.sqlite,sql-wasm.wasm,database/**,api/**,node_modules/sql.js/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ]
}
